MYSQL_DATABASE=talentassistant_dev
MYSQL_USER=talentassistant_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Autenticación local (SPEC-005). Completa estos valores en tu .env local;
# nunca los confirmes en Git con valores reales.
# Clave de firma JWT (>= 32 caracteres aleatorios). Obligatoria: sin ella la API no arranca.
AUTH_SIGNING_KEY=
# Usuario sintético sembrado por db-init.
AUTH_SEED_USER=demo@talentassistant.local
# Contraseña del usuario sembrado. Obligatoria; debe cumplir la política de Identity
# (mayúscula, minúscula, dígito y carácter no alfanumérico, mínimo 6 caracteres).
AUTH_SEED_PASSWORD=
# Duración del token JWT en minutos (por defecto 60).
AUTH_TOKEN_LIFETIME_MINUTES=60
