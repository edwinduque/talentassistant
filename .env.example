MYSQL_DATABASE=talentassistant_dev
MYSQL_USER=talentassistant_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# AutenticaciÃƒÆ’Ã‚Â³n local (SPEC-005). Completa estos valores en tu .env local;
# nunca los confirmes en Git con valores reales.
# Clave de firma JWT (>= 32 caracteres aleatorios). Obligatoria: sin ella la API no arranca.
AUTH_SIGNING_KEY=
# Usuario sintÃƒÆ’Ã‚Â©tico sembrado por db-init.
AUTH_SEED_USER=demo@talentassistant.local
# ContraseÃƒÆ’Ã‚Â±a del usuario sembrado. Obligatoria; debe cumplir la polÃƒÆ’Ã‚Â­tica de Identity
# (mayÃƒÆ’Ã‚Âºscula, minÃƒÆ’Ã‚Âºscula, dÃƒÆ’Ã‚Â­gito y carÃƒÆ’Ã‚Â¡cter no alfanumÃƒÆ’Ã‚Â©rico, mÃƒÆ’Ã‚Â­nimo 6 caracteres).
AUTH_SEED_PASSWORD=
# DuraciÃƒÆ’Ã‚Â³n del token JWT en minutos (por defecto 60).
AUTH_TOKEN_LIFETIME_MINUTES=60

# IA del asistente (Groq por defecto)
