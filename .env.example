APP_POSTGRES_ADMIN=talentassistant_admin
APP_POSTGRES_ADMIN_PASSWORD=
# Contraseña del rol de la aplicación (sin privilegios de superusuario).
APP_POSTGRES_PASSWORD=
APP_POSTGRES_DB=talentassistant_dev

# AutenticaciÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³n local (SPEC-005). Completa estos valores en tu .env local;
# nunca los confirmes en Git con valores reales.
# Clave de firma JWT (>= 32 caracteres aleatorios). Obligatoria: sin ella la API no arranca.
AUTH_SIGNING_KEY=
# Usuario sintÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©tico sembrado por db-init.
AUTH_SEED_USER=demo@talentassistant.local
# ContraseÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â±a del usuario sembrado. Obligatoria; debe cumplir la polÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â­tica de Identity
# (mayÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Âºscula, minÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Âºscula, dÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â­gito y carÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¡cter no alfanumÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©rico, mÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â­nimo 6 caracteres).
AUTH_SEED_PASSWORD=
# DuraciÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³n del token JWT en minutos (por defecto 60).
AUTH_TOKEN_LIFETIME_MINUTES=60

# IA del asistente (Groq por defecto)
AI_BASE_URL=https://api.groq.com/openai/v1
# id con soporte de tools, confirmado con la API de Groq (los Llama no estan en todos los planes)
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=

# PostgreSQL local de pruebas del contrato HCM (SPEC-011) - solo pruebas local.
# La base real del HCM usa las variables HCM__ (host/puerto/base/usuario/
# clave/SSLMode) que se añaden en la fase de adaptadores; nunca en el repo.
HCM_POSTGRES_DB=talentassistant_hcm
HCM_POSTGRES_USER=talentassistant_hcm_admin
HCM_POSTGRES_PASSWORD=talentassistant_hcm_local
HCM_POSTGRES_APP_PASSWORD=talentassistant_hcm_app_local

# Conector HCM real (SPEC-011) - solo en tu .env local; nunca en el repo, el
# chat ni los logs. Valores vacíos: la fuente por defecto es Sintética.
# Modo de la fuente HCM: Sintética (por defecto) o Postgres; interruptor único
# que gobierna todos los puertos de datos a la vez.
Hcm__Source=
# Cadena de conexión a la base real del HCM: Host, Puerto, Base, Usuario,
# Clave y Ssl Mode=VerifyFull (TLS exigido para la base real; el servicio
# local de pruebas hcm-postgres es la excepción sin TLS documentada).
HcmPostgres__ConnectionString=
# Tiempo de espera por comando en segundos (por defecto 15).
HcmPostgres__CommandTimeoutSeconds=15