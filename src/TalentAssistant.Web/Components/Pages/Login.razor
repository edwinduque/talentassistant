@page "/login"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | Talent Assistant</PageTitle>

<div class="login-page">
    <style>
        .login-card {
            max-width: 34rem;
        }

        .login-card-content {
            padding: 2rem;
        }

        .login-form {
            display: grid;
            gap: 1.25rem;
        }

        .login-field {
            display: grid;
            gap: 0.35rem;
        }

        .login-field label {
            font-weight: 600;
        }

        .login-control {
            min-height: 2.75rem;
            padding: 0.5rem 0.75rem;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--ink);
            font: inherit;
        }

        .login-control:focus-visible {
            outline: 3px solid var(--focus);
            outline-offset: 2px;
        }

        .login-error {
            margin: 0;
            color: var(--danger);
            font-weight: 600;
        }

        .login-action button {
            min-height: 2.75rem;
            padding: 0.5rem 1.5rem;
            border: 1px solid var(--accent);
            background: var(--accent);
            color: var(--canvas);
            font: inherit;
            font-weight: 650;
            cursor: pointer;
        }
    </style>

    <header class="overview-heading">
        <p class="eyebrow">Talent Assistant</p>
        <h1>Iniciar sesión</h1>
        <p class="overview-intro">
            Introduce tu usuario local para acceder a la aplicación.
        </p>
    </header>

    <section class="status-card login-card" aria-label="Formulario de inicio de sesión">
        <div class="status-rail" aria-hidden="true"></div>
        <div class="status-card-content login-card-content">
            <form action="/session/login" method="post" class="login-form">
                <input type="hidden" name="ReturnUrl" value="@_returnUrl" />
                <div class="login-field">
                    <label for="login-user-name">Usuario</label>
                    <input id="login-user-name"
                           class="login-control"
                           type="text"
                           name="UserName"
                           autocomplete="username"
                           autofocus
                           required />
                </div>
                <div class="login-field">
                    <label for="login-password">Contraseña</label>
                    <input id="login-password"
                           class="login-control"
                           type="password"
                           name="Password"
                           autocomplete="current-password"
                           required />
                </div>

                @if (_hasFailed)
                {
                    <p class="login-error" role="alert">Usuario o contraseña incorrectos</p>
                }

                <div class="login-action">
                    <button type="submit">Entrar</button>
                </div>
            </form>
        </div>
    </section>
</div>

@code {
    private string _returnUrl = "/";
    private bool _hasFailed;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        _hasFailed = query.ContainsKey("error");

        var returnUrl = query.TryGetValue("ReturnUrl", out var values)
            ? values.FirstOrDefault()
            : null;
        if (!string.IsNullOrEmpty(returnUrl)
            && returnUrl.StartsWith('/')
            && !returnUrl.StartsWith("//"))
        {
            _returnUrl = returnUrl;
        }
    }
}
