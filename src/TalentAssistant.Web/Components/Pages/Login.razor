@page "/login"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IStringLocalizer<Login> Local
@inject IStringLocalizer<Common> CommonLocal

<PageTitle>@Local["PageTitle"]</PageTitle>

<div class="login-page">
    <style>
        .login-card {
            max-width: 34rem;
        }

        .login-card-content {
            padding: 2rem;
        }

        .login-form {
            display: grid;
            gap: 1.25rem;
        }

        .login-field {
            display: grid;
            gap: 0.35rem;
        }

        .login-field label {
            font-weight: 600;
        }

        .login-control {
            min-height: 2.75rem;
            padding: 0.5rem 0.75rem;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--ink);
            font: inherit;
        }

        .login-control:focus-visible {
            outline: 3px solid var(--focus);
            outline-offset: 2px;
        }

        .login-error {
            margin: 0;
            color: var(--danger);
            font-weight: 600;
        }

        .login-action button {
            min-height: 2.75rem;
            padding: 0.5rem 1.5rem;
            border: 1px solid var(--accent);
            background: var(--accent);
            color: var(--canvas);
            font: inherit;
            font-weight: 650;
            cursor: pointer;
        }

        .language-card {
            max-width: 34rem;
            margin-top: 1.5rem;
        }
    </style>

    <header class="overview-heading">
        <p class="eyebrow">@CommonLocal["AppName"]</p>
        <h1>@Local["Title"]</h1>
        <p class="overview-intro">
            @Local["Subtitle"]
        </p>
    </header>

    <section class="status-card login-card" aria-label="@Local["SignInFormLabel"]">
        <div class="status-rail" aria-hidden="true"></div>
        <div class="status-card-content login-card-content">
            <form action="/session/login" method="post" class="login-form">
                <input type="hidden" name="ReturnUrl" value="@_returnUrl" />
                <div class="login-field">
                    <label for="login-user-name">@Local["UserName"]</label>
                    <input id="login-user-name"
                           class="login-control"
                           type="text"
                           name="UserName"
                           autocomplete="username"
                           autofocus
                           required />
                </div>
                <div class="login-field">
                    <label for="login-password">@Local["Password"]</label>
                    <input id="login-password"
                           class="login-control"
                           type="password"
                           name="Password"
                           autocomplete="current-password"
                           required />
                </div>

                @if (_hasFailed)
                {
                    <p class="login-error" role="alert">@Local["InvalidCredentials"]</p>
                }

                <div class="login-action">
                    <button type="submit">@Local["SignIn"]</button>
                </div>
            </form>
        </div>
    </section>

    <section class="status-card language-card" aria-label="@Local["LanguageFormLabel"]">
        <div class="status-rail" aria-hidden="true"></div>
        <div class="status-card-content login-card-content">
            <form action="/session/culture" method="post" class="login-form">
                <input type="hidden" name="ReturnUrl" value="@_cultureReturnUrl" />
                <div class="login-field">
                    <label for="login-culture">@CommonLocal["Language"]</label>
                    <select id="login-culture"
                            class="login-control"
                            name="culture"
                            aria-label="@CommonLocal["Language"]">
                        <option value="es" selected="@(_selectedCulture == "es")">@CommonLocal["LanguageEs"]</option>
                        <option value="en" selected="@(_selectedCulture == "en")">@CommonLocal["LanguageEn"]</option>
                    </select>
                </div>

                @if (_cultureFailed)
                {
                    <p class="login-error" role="alert">@Local["CultureError"]</p>
                }

                <div class="login-action">
                    <button type="submit">@CommonLocal["Apply"]</button>
                </div>
            </form>
        </div>
    </section>
</div>

@code {
    private string _returnUrl = "/";
    private string _cultureReturnUrl = "/";
    private bool _hasFailed;
    private bool _cultureFailed;
    private string _selectedCulture = SessionCulture.Default;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        _hasFailed = query.ContainsKey("error");
        _cultureFailed = query.ContainsKey("cultureError");

        var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        if (SessionCulture.IsSupported(culture))
        {
            _selectedCulture = culture;
        }

        var returnUrl = query.TryGetValue("ReturnUrl", out var values)
            ? values.FirstOrDefault()
            : null;
        if (!string.IsNullOrEmpty(returnUrl)
            && returnUrl.StartsWith('/')
            && !returnUrl.StartsWith("//"))
        {
            _returnUrl = returnUrl;
        }

        // The language form returns to the current path only: query flags such as
        // ?cultureError=1 must not survive a successful language change.
        _cultureReturnUrl = uri.AbsolutePath;
    }
}
