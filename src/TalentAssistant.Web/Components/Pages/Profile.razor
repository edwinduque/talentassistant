@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationState
@inject AuthApiClient AuthApi
@inject IStringLocalizer<Profile> Local
@inject IStringLocalizer<Common> CommonLocal

<PageTitle>@Local["PageTitle"]</PageTitle>

<div class="profile-page">
    <header class="overview-heading">
        <p class="eyebrow">@CommonLocal["AppName"]</p>
        <h1>@Local["Title"]</h1>
        <p class="overview-intro">@Local["Subtitle"]</p>
    </header>

    @if (_loadFailed)
    {
        <p class="profile-message profile-message--error" role="alert">@Local["ProfileLoadFailed"]</p>
    }

    <div class="profile-grid">
        <section class="status-card profile-card" aria-labelledby="profile-display-name-heading">
            <div class="profile-card-header profile-card-header--identity">
                @if (!string.IsNullOrEmpty(_initials))
                {
                    <span class="profile-avatar" aria-hidden="true">@_initials</span>
                }
                <div class="profile-card-heading">
                    <h2 id="profile-display-name-heading">@Local["DisplayNameHeading"]</h2>
                    @if (_profile is not null)
                    {
                        <p class="profile-username">@Local["UserNameHint", _profile.UserName]</p>
                    }
                </div>
            </div>
            <div class="profile-card-body">
                <form action="/session/profile" method="post" class="profile-form">
                    <input type="hidden" name="ReturnUrl" value="@_returnUrl" />
                    <div class="profile-field">
                        <label for="profile-full-name">@Local["FullNameLabel"]</label>
                        <input id="profile-full-name"
                               class="profile-control"
                               type="text"
                               name="FullName"
                               value="@_fullName"
                               maxlength="100"
                               autocomplete="name" />
                    </div>
                    <div class="profile-field">
                        <label for="profile-language">@CommonLocal["Language"]</label>
                        <select id="profile-language"
                                class="profile-control"
                                name="PreferredLanguage"
                                aria-label="@CommonLocal["Language"]">
                            <option value="es" selected="@(_preferredLanguage == "es")">@CommonLocal["LanguageEs"]</option>
                            <option value="en" selected="@(_preferredLanguage == "en")">@CommonLocal["LanguageEn"]</option>
                        </select>
                    </div>

                    @if (_profileError)
                    {
                        <p class="profile-message profile-message--error" role="alert">@Local["ProfileSaveFailed"]</p>
                    }

                    <div class="profile-action">
                        <button type="submit">@CommonLocal["Save"]</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="status-card profile-card" aria-labelledby="profile-password-heading">
            <div class="profile-card-header">
                <div class="profile-card-heading">
                    <p class="eyebrow">@Local["SecurityEyebrow"]</p>
                    <h2 id="profile-password-heading">@Local["ChangePasswordHeading"]</h2>
                    <p class="profile-username" id="profile-password-help">@Local["PasswordPolicyHint"]</p>
                </div>
            </div>
            <div class="profile-card-body">
                <form action="/session/password" method="post" class="profile-form">
                    <input type="hidden" name="ReturnUrl" value="@_returnUrl" />
                    <div class="profile-field">
                        <label for="profile-current-password">@Local["CurrentPasswordLabel"]</label>
                        <input id="profile-current-password"
                               class="profile-control"
                               type="password"
                               name="CurrentPassword"
                               autocomplete="current-password"
                               required />
                    </div>
                    <div class="profile-field">
                        <label for="profile-new-password">@Local["NewPasswordLabel"]</label>
                        <input id="profile-new-password"
                               class="profile-control"
                               type="password"
                               name="NewPassword"
                               autocomplete="new-password"
                               aria-describedby="profile-password-help"
                               required />
                    </div>
                    <div class="profile-field">
                        <label for="profile-confirm-password">@Local["ConfirmPasswordLabel"]</label>
                        <input id="profile-confirm-password"
                               class="profile-control"
                               type="password"
                               name="ConfirmPassword"
                               autocomplete="new-password"
                               aria-describedby="profile-password-help"
                               required />
                    </div>

                    @if (_passwordChanged)
                    {
                        <p class="profile-message profile-message--success" role="status">@Local["PasswordChanged"]</p>
                    }

                    @if (_passwordError is not null)
                    {
                        <p class="profile-message profile-message--error" role="alert">@Local[_passwordError]</p>
                    }

                    <div class="profile-action">
                        <button type="submit">@Local["ChangePasswordButton"]</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@code {
    private string _returnUrl = "/profile";
    private UserProfileResult? _profile;
    private bool _loadFailed;
    private string _fullName = string.Empty;
    private string _preferredLanguage = SessionCulture.Default;
    private bool _profileError;
    private bool _passwordChanged;
    private string? _passwordError;
    private string _initials = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // Flags are consumed once and dropped: the forms post to the clean path
        // so a result message cannot be replayed on the next navigation.
        _returnUrl = uri.AbsolutePath;
        _profileError = query.ContainsKey("profileError");
        _passwordChanged = query.ContainsKey("passwordChanged");
        _passwordError = query.TryGetValue("passwordError", out var errors)
            ? PasswordErrorKey(errors.FirstOrDefault())
            : null;

        var authenticationState = await AuthenticationState.GetAuthenticationStateAsync();
        var accessToken = authenticationState.User.FindFirst(
            AuthenticationMessageHandler.AccessTokenClaimType)?.Value;
        if (string.IsNullOrEmpty(accessToken))
        {
            _loadFailed = true;
            return;
        }

        _profile = await AuthApi.GetProfileAsync(accessToken);
        if (_profile is null)
        {
            _loadFailed = true;
            return;
        }

        _fullName = _profile.FullName;
        _initials = GetInitials(_fullName, _profile.UserName);
        if (SessionCulture.IsSupported(_profile.PreferredLanguage))
        {
            _preferredLanguage = _profile.PreferredLanguage;
        }
    }

    // Presentation-only initials for the identity header: first letter of the
    // two first name words, or the first two letters when only one word exists.
    private static string GetInitials(string fullName, string userName)
    {
        var source = string.IsNullOrWhiteSpace(fullName) ? userName : fullName;
        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return string.Empty;
        }

        var letters = parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}"
            : parts[0].Substring(0, Math.Min(2, parts[0].Length));
        return letters.ToUpperInvariant();
    }

    // Maps the ?passwordError= query flag to a resource key.
    private static string? PasswordErrorKey(string? flag) =>
        flag switch
        {
            "confirm" => "PasswordsDoNotMatch",
            "current" => "WrongCurrentPassword",
            "policy" => "PasswordPolicyNotMet",
            "service" => "PasswordChangeFailed",
            _ => null,
        };
}
