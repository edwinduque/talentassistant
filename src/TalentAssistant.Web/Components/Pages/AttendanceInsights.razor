@page "/attendance-insights"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inject BackendApiClient BackendApi
@inject IStringLocalizer<AttendanceInsights> Local

<PageTitle>@Local["PageTitle"]</PageTitle>

<div class="attendance-page">
    <header class="attendance-heading">
        <p class="eyebrow">@Local["Eyebrow"]</p>
        <h1>@Local["Title"]</h1>
        <p class="attendance-intro">
            @Local["Subtitle"]
        </p>
        <p class="synthetic-notice">
            <strong>@Local["SyntheticNoticeTitle"]</strong>
            <span>@Local["SyntheticNoticeText"]</span>
        </p>
    </header>

    <section class="filter-panel" aria-labelledby="filters-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@Local["FiltersEyebrow"]</p>
                <h2 id="filters-heading">@Local["FiltersHeading"]</h2>
            </div>
            <p id="date-range-help" class="filter-help">
                @Local["DateRangeHelp"]
            </p>
        </div>

        <EditForm Model="_filters" OnValidSubmit="LoadAsync">
            <fieldset class="filter-fields">
                <legend class="visually-hidden">@Local["FiltersLegend"]</legend>
                <div class="filter-field">
                    <label for="from-date">@Local["FromDateLabel"]</label>
                    <InputDate id="from-date"
                               TValue="DateTime?"
                               class="filter-control"
                               aria-describedby="date-range-help"
                               @bind-Value="_filters.From" />
                    @if (_fromError is not null)
                    {
                        <p class="error-message" role="alert">@_fromError</p>
                    }
                </div>
                <div class="filter-field">
                    <label for="to-date">@Local["ToDateLabel"]</label>
                    <InputDate id="to-date"
                               TValue="DateTime?"
                               class="filter-control"
                               aria-describedby="date-range-help"
                               @bind-Value="_filters.To" />
                    @if (_toError is not null)
                    {
                        <p class="error-message" role="alert">@_toError</p>
                    }
                </div>
                <div class="filter-action">
                    <button type="submit" disabled="@_isLoading">
                        @(_isLoading ? Local["LoadingButton"] : Local["SearchButton"])
                    </button>
                </div>
            </fieldset>
        </EditForm>
    </section>

    <section class="results-section" aria-labelledby="results-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@Local["ResultsEyebrow"]</p>
                <h2 id="results-heading">@Local["ResultsHeading"]</h2>
            </div>
            @if (_hasSearched && _error is null)
            {
                <p class="result-count" role="status" aria-live="polite">
                    @Local["FindingsCount", _insights.Count]
                </p>
            }
        </div>

        @if (_isLoading)
        {
            <p class="status-message" role="status" aria-live="polite">@Local["LoadingMessage"]</p>
        }
        else if (_error is not null)
        {
            <p class="error-message" role="alert">@_error</p>
        }
        else if (_hasSearched && _insights.Count == 0)
        {
            <p class="empty-message" role="status">@Local["NoResults"]</p>
        }
        else if (_insights.Count > 0)
        {
            <ul class="insight-list">
                @foreach (var insight in _insights)
                {
                    <li>
                        <article class="insight-card @(insight.RuleFinding.RequiresReview ? "insight-card--review" : string.Empty)">
                            <header class="insight-card-heading">
                                <div>
                                    <p class="eyebrow">@Local["FindingEyebrow", insight.IncidentId]</p>
                                    <h3>@insight.Employee.DisplayName</h3>
                                </div>
                                <span class="review-badge @(insight.RuleFinding.RequiresReview ? "review-badge--needed" : "review-badge--clear")">
                                    @(insight.RuleFinding.RequiresReview ? Local["NeedsReview"] : Local["NoReview"])
                                </span>
                            </header>

                            <dl class="insight-facts">
                                <div>
                                    <dt>@Local["OfficeLabel"]</dt>
                                    <dd>@insight.Office.Country · @insight.Office.City</dd>
                                </div>
                                <div>
                                    <dt>@Local["OfficeTimeZoneLabel"]</dt>
                                    <dd><code>@insight.Office.IanaTimeZoneId</code></dd>
                                </div>
                                <div>
                                    <dt>@Local["AttendanceTimeLabel"]</dt>
                                    <dd>@FormatOfficeTime(insight)</dd>
                                </div>
                                <div>
                                    <dt>@Local["ScheduledShiftLabel"]</dt>
                                    <dd>@insight.Schedule.WorkDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) · @insight.Schedule.StartsAt.ToString("HH:mm", CultureInfo.InvariantCulture)–@insight.Schedule.EndsAt.ToString("HH:mm", CultureInfo.InvariantCulture)</dd>
                                </div>
                            </dl>

                            <section class="finding-details" aria-label="@Local["RuleSectionLabel"]">
                                <p class="eyebrow">@Local["RuleResultEyebrow", insight.RuleFinding.RuleReference]</p>
                                <p class="finding-summary">@insight.RuleFinding.Summary</p>
                            </section>

                            <section class="evidence-section" aria-label="@Local["EvidenceSectionLabel"]">
                                <h4>@Local["EvidenceHeading"]</h4>
                                <ul>
                                    @foreach (var evidence in insight.RuleFinding.Evidence)
                                    {
                                        <li>@evidence</li>
                                    }
                                </ul>
                            </section>

                            @if (insight.RuleFinding.ReviewItems.Count > 0)
                            {
                                <section class="review-section" aria-label="@Local["ReviewSectionLabel"]">
                                    <h4>@Local["ReviewHeading"]</h4>
                                    <ul>
                                        @foreach (var item in insight.RuleFinding.ReviewItems)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </section>
                            }

                            @if (insight.Punches.Count > 0)
                            {
                                <details class="punch-details">
                                    <summary>@Local["ViewPunches"]</summary>
                                    <ul>
                                        @foreach (var punch in insight.Punches)
                                        {
                                            <li>@FormatOfficeTime(punch.OccurredAtUtc, insight.Office.IanaTimeZoneId) — @punch.Description</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (insight.RelatedTimeOff is not null)
                            {
                                <section class="timeoff-context" aria-label="@Local["TimeOffHeading"]">
                                    <h4>@Local["TimeOffHeading"]</h4>
                                    <p>@insight.RelatedTimeOff.Summary</p>
                                    <dl class="insight-facts">
                                        <div>
                                            <dt>@Local["TimeOffTypeLabel"]</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.Type)</dd>
                                        </div>
                                        <div>
                                            <dt>@Local["TimeOffStatusLabel"]</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.Status)</dd>
                                        </div>
                                        <div>
                                            <dt>@Local["TimeOffReferenceLabel"]</dt>
                                            <dd>@insight.RelatedTimeOff.Reference</dd>
                                        </div>
                                        <div>
                                            <dt>@Local["TimeOffStartDateLabel"]</dt>
                                            <dd>@insight.RelatedTimeOff.StartsOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
                                        </div>
                                        <div>
                                            <dt>@Local["TimeOffEndDateLabel"]</dt>
                                            <dd>@insight.RelatedTimeOff.EndsBefore.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
                                        </div>
                                        <div>
                                            <dt>@Local["TimeOffDurationLabel"]</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.Duration)</dd>
                                        </div>
                                        <div>
                                            <dt>@Local["TimeOffDurationUnitLabel"]</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.DurationUnit)</dd>
                                        </div>
                                    </dl>
                                    <p class="context-reference">
                                        @Local["TimeOffDisclaimer"]
                                    </p>
                                </section>
                            }
                            else
                            {
                                <section class="timeoff-context" aria-label="@Local["TimeOffHeading"]">
                                    <h4>@Local["TimeOffHeading"]</h4>
                                    <p>@Local["TimeOffMissing"]</p>
                                </section>
                            }
                        </article>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="empty-message">@Local["NoSearchHint"]</p>
        }
    </section>
</div>

@code {
    private readonly AttendanceFilterModel _filters = new();
    private IReadOnlyList<AttendanceInsightResponse> _insights = Array.Empty<AttendanceInsightResponse>();
    private bool _isLoading;
    private bool _hasSearched;
    private string? _error;
    private string? _fromError;
    private string? _toError;

    private async Task LoadAsync()
    {
        _error = null;
        _fromError = null;
        _toError = null;
        _hasSearched = true;

        // Explicit checks instead of [Required(ErrorMessage)]: Blazor cannot
        // localize DataAnnotations attribute messages without resource-type
        // attributes, and S3 requires no hardcoded visible strings.
        if (_filters.From is null)
        {
            _fromError = Local["FromDateRequired"].Value;
        }

        if (_filters.To is null)
        {
            _toError = Local["ToDateRequired"].Value;
        }

        if (_fromError is not null || _toError is not null)
        {
            return;
        }

        var from = DateOnly.FromDateTime(_filters.From!.Value);
        var to = DateOnly.FromDateTime(_filters.To!.Value);
        if (from >= to)
        {
            _error = Local["InvalidDateRange"].Value;
            return;
        }

        _isLoading = true;
        try
        {
            var result = await BackendApi.GetAttendanceInsightsAsync(
                from,
                to);
            if (result.IsSuccess)
            {
                _insights = result.Insights;
            }
            else
            {
                _insights = Array.Empty<AttendanceInsightResponse>();
                _error = Local[FailureMessageKey(result.Failure)].Value;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FailureMessageKey(AttendanceInsightsFailure failure) =>
        failure switch
        {
            AttendanceInsightsFailure.BadRequest => "ErrorBadRequest",
            AttendanceInsightsFailure.Unreachable => "ErrorUnreachable",
            AttendanceInsightsFailure.Timeout => "ErrorTimeout",
            AttendanceInsightsFailure.SourceUnavailable => "ErrorSourceUnavailable",
            _ => "ErrorInvalidPayload",
        };

    private static string FormatOfficeTime(
        AttendanceInsightResponse insight) =>
        FormatOfficeTime(insight.IncidentAtUtc, insight.Office.IanaTimeZoneId);

    private static string FormatOfficeTime(DateTimeOffset utcTime, string ianaTimeZoneId)
    {
        var officeTimeZone = TimeZoneInfo.FindSystemTimeZoneById(ianaTimeZoneId);
        return TimeZoneInfo.ConvertTime(utcTime, officeTimeZone)
            .ToString("yyyy-MM-dd HH:mm zzz", CultureInfo.InvariantCulture);
    }

    private string FormatSourceValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? Local["NotProvided"].Value : value;

    private sealed class AttendanceFilterModel
    {
        public DateTime? From { get; set; }

        public DateTime? To { get; set; }
    }
}
