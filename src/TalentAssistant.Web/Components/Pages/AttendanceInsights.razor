@page "/attendance-insights"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inject BackendApiClient BackendApi

<PageTitle>Attendance insights | Talent Assistant</PageTitle>

<div class="attendance-page">
    <header class="attendance-heading">
        <p class="eyebrow">HCM assistance</p>
        <h1>Attendance insights</h1>
        <p class="attendance-intro">
            Review attendance findings supplied by the HCM, their supporting evidence,
            and related context that may need your attention.
        </p>
        <p class="synthetic-notice">
            <strong>Synthetic HCM data</strong>
            <span>People and office locations shown here are examples, not company records.</span>
        </p>
    </header>

    <section class="filter-panel" aria-labelledby="filters-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Search the HCM sample</p>
                <h2 id="filters-heading">Choose an attendance period</h2>
            </div>
            <p id="date-range-help" class="filter-help">
                The start date is included and the end date is excluded, using each office's time zone.
            </p>
        </div>

        <EditForm Model="_filters" OnValidSubmit="LoadAsync">
            <DataAnnotationsValidator />
            <fieldset class="filter-fields">
                <legend class="visually-hidden">Attendance filters</legend>
                <div class="filter-field">
                    <label for="from-date">From (inclusive)</label>
                    <InputDate id="from-date"
                               TValue="DateTime?"
                               class="filter-control"
                               aria-describedby="date-range-help"
                               @bind-Value="_filters.From" />
                    <ValidationMessage For="@(() => _filters.From)" />
                </div>
                <div class="filter-field">
                    <label for="to-date">To (exclusive)</label>
                    <InputDate id="to-date"
                               TValue="DateTime?"
                               class="filter-control"
                               aria-describedby="date-range-help"
                               @bind-Value="_filters.To" />
                    <ValidationMessage For="@(() => _filters.To)" />
                </div>
                <div class="filter-field">
                    <label for="employee-id">Employee ID (optional)</label>
                    <InputText id="employee-id"
                               class="filter-control"
                               @bind-Value="_filters.EmployeeId" />
                </div>
                <div class="filter-action">
                    <button type="submit" disabled="@_isLoading">
                        @(_isLoading ? "Loading…" : "Search attendance")
                    </button>
                </div>
            </fieldset>
            <div class="validation-summary" role="status" aria-live="polite">
                <ValidationSummary />
            </div>
        </EditForm>
    </section>

    <section class="results-section" aria-labelledby="results-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Source-provided findings</p>
                <h2 id="results-heading">Attendance context</h2>
            </div>
            @if (_hasSearched && _error is null)
            {
                <p class="result-count" role="status" aria-live="polite">
                    @_insights.Count finding(s)
                </p>
            }
        </div>

        @if (_isLoading)
        {
            <p class="status-message" role="status" aria-live="polite">Loading HCM attendance context…</p>
        }
        else if (_error is not null)
        {
            <p class="error-message" role="alert">@_error</p>
        }
        else if (_hasSearched && _insights.Count == 0)
        {
            <p class="empty-message" role="status">No attendance findings matched this period.</p>
        }
        else if (_insights.Count > 0)
        {
            <ul class="insight-list">
                @foreach (var insight in _insights)
                {
                    <li>
                        <article class="insight-card @(insight.RuleFinding.RequiresReview ? "insight-card--review" : string.Empty)">
                            <header class="insight-card-heading">
                                <div>
                                    <p class="eyebrow">HCM finding · @insight.IncidentId</p>
                                    <h3>@insight.Employee.DisplayName</h3>
                                </div>
                                <span class="review-badge @(insight.RuleFinding.RequiresReview ? "review-badge--needed" : "review-badge--clear")">
                                    @(insight.RuleFinding.RequiresReview ? "Needs review" : "No review flagged")
                                </span>
                            </header>

                            <dl class="insight-facts">
                                <div>
                                    <dt>Office</dt>
                                    <dd>@insight.Office.Country · @insight.Office.City</dd>
                                </div>
                                <div>
                                    <dt>Office time zone</dt>
                                    <dd><code>@insight.Office.IanaTimeZoneId</code></dd>
                                </div>
                                <div>
                                    <dt>Attendance time</dt>
                                    <dd>@FormatOfficeTime(insight)</dd>
                                </div>
                                <div>
                                    <dt>Scheduled shift</dt>
                                    <dd>@insight.Schedule.WorkDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) · @insight.Schedule.StartsAt.ToString("HH:mm", CultureInfo.InvariantCulture)–@insight.Schedule.EndsAt.ToString("HH:mm", CultureInfo.InvariantCulture)</dd>
                                </div>
                            </dl>

                            <section class="finding-details" aria-label="HCM rule result">
                                <p class="eyebrow">HCM-reported result · @insight.RuleFinding.RuleReference</p>
                                <p class="finding-summary">@insight.RuleFinding.Summary</p>
                            </section>

                            <section class="evidence-section" aria-label="Supporting evidence">
                                <h4>Evidence supplied by the HCM</h4>
                                <ul>
                                    @foreach (var evidence in insight.RuleFinding.Evidence)
                                    {
                                        <li>@evidence</li>
                                    }
                                </ul>
                            </section>

                            @if (insight.RuleFinding.ReviewItems.Count > 0)
                            {
                                <section class="review-section" aria-label="Information to review">
                                    <h4>Information to review</h4>
                                    <ul>
                                        @foreach (var item in insight.RuleFinding.ReviewItems)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </section>
                            }

                            @if (insight.Punches.Count > 0)
                            {
                                <details class="punch-details">
                                    <summary>View supplied punch events</summary>
                                    <ul>
                                        @foreach (var punch in insight.Punches)
                                        {
                                            <li>@FormatOfficeTime(punch.OccurredAtUtc, insight.Office.IanaTimeZoneId) — @punch.Description</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (insight.RelatedTimeOff is not null)
                            {
                                <section class="timeoff-context" aria-label="Related TimeOff context">
                                    <h4>Related TimeOff context</h4>
                                    <p>@insight.RelatedTimeOff.Summary</p>
                                    <dl class="insight-facts">
                                        <div>
                                            <dt>Type</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.Type)</dd>
                                        </div>
                                        <div>
                                            <dt>Status supplied by the HCM</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.Status)</dd>
                                        </div>
                                        <div>
                                            <dt>Reference</dt>
                                            <dd>@insight.RelatedTimeOff.Reference</dd>
                                        </div>
                                        <div>
                                            <dt>Start date value supplied</dt>
                                            <dd>@insight.RelatedTimeOff.StartsOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
                                        </div>
                                        <div>
                                            <dt>End date value supplied</dt>
                                            <dd>@insight.RelatedTimeOff.EndsBefore.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
                                        </div>
                                        <div>
                                            <dt>Duration</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.Duration)</dd>
                                        </div>
                                        <div>
                                            <dt>Duration unit</dt>
                                            <dd>@FormatSourceValue(insight.RelatedTimeOff.DurationUnit)</dd>
                                        </div>
                                    </dl>
                                    <p class="context-reference">
                                        The source-declared relationship does not establish that this absence explains the attendance finding.
                                    </p>
                                </section>
                            }
                            else
                            {
                                <section class="timeoff-context" aria-label="Related TimeOff context">
                                    <h4>Related TimeOff context</h4>
                                    <p>The HCM did not provide related TimeOff context for this attendance finding.</p>
                                </section>
                            }
                        </article>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="empty-message">Choose a date range to view the synthetic HCM findings.</p>
        }
    </section>
</div>

@code {
    private readonly AttendanceFilterModel _filters = new();
    private IReadOnlyList<AttendanceInsightResponse> _insights = Array.Empty<AttendanceInsightResponse>();
    private bool _isLoading;
    private bool _hasSearched;
    private string? _error;

    private async Task LoadAsync()
    {
        _error = null;
        _hasSearched = true;

        if (_filters.From is null || _filters.To is null)
        {
            _error = "Enter both dates to search the HCM sample.";
            return;
        }

        var from = DateOnly.FromDateTime(_filters.From.Value);
        var to = DateOnly.FromDateTime(_filters.To.Value);
        if (from >= to)
        {
            _error = "The end date must be later than the start date.";
            return;
        }

        _isLoading = true;
        try
        {
            var result = await BackendApi.GetAttendanceInsightsAsync(
                from,
                to,
                _filters.EmployeeId);
            if (result.IsSuccess)
            {
                _insights = result.Insights;
            }
            else
            {
                _insights = Array.Empty<AttendanceInsightResponse>();
                _error = result.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatOfficeTime(
        AttendanceInsightResponse insight) =>
        FormatOfficeTime(insight.IncidentAtUtc, insight.Office.IanaTimeZoneId);

    private static string FormatOfficeTime(DateTimeOffset utcTime, string ianaTimeZoneId)
    {
        var officeTimeZone = TimeZoneInfo.FindSystemTimeZoneById(ianaTimeZoneId);
        return TimeZoneInfo.ConvertTime(utcTime, officeTimeZone)
            .ToString("yyyy-MM-dd HH:mm zzz", CultureInfo.InvariantCulture);
    }

    private static string FormatSourceValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not provided by the HCM" : value;

    private sealed class AttendanceFilterModel
    {
        [Required(ErrorMessage = "Enter a start date.")]
        public DateTime? From { get; set; }

        [Required(ErrorMessage = "Enter an end date.")]
        public DateTime? To { get; set; }

        public string? EmployeeId { get; set; }
    }
}
