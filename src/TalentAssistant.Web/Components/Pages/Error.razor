@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<Common> CommonLocal

<PageTitle>@CommonLocal["ErrorTitle"]</PageTitle>

<h1 class="text-danger">@CommonLocal["ErrorTitle"]</h1>
<h2 class="text-danger">@CommonLocal["ErrorMessage"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@CommonLocal["RequestId"]:</strong> <code>@RequestId</code>
    </p>
}

<h3>@CommonLocal["ErrorGuidanceTitle"]</h3>
<p>@CommonLocal["ErrorGuidanceIntro"]</p>
<p>@CommonLocal["ErrorGuidanceDetail"]</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
