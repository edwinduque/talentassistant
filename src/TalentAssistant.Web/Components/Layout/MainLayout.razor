@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject SessionService Session
@inject NavigationManager Navigation

<div class="app-shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="masthead">
        <a class="brand" href="/" aria-label="Talent Assistant home">
            <span class="brand-mark" aria-hidden="true">TA</span>
            <span class="brand-name">Talent Assistant</span>
        </a>

        <AuthorizeView>
            <Authorized>
                <nav class="primary-navigation" aria-label="Primary navigation">
                    <NavLink href="" Match="NavLinkMatch.All">Overview</NavLink>
                    <NavLink href="attendance-insights">Attendance insights</NavLink>
                </nav>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <span class="user-name">@context.User.Identity?.Name</span>
                <button type="button" class="sign-out-button" @onclick="SignOutAsync">Cerrar sesión</button>
            </Authorized>
        </AuthorizeView>

        <p class="environment-label">Local development</p>
    </header>

    <main class="page-content" id="main-content" tabindex="-1">
        <article>
            @Body
        </article>
    </main>

    <footer class="site-footer">
        <span>Technical foundation</span>
        <span>Local environment · synthetic data</span>
    </footer>
</div>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    <span>An unexpected error occurred.</span>
    <a href="/">Reload the page</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">×</button>
</div>

<style>
    .user-name {
        color: var(--muted);
        font-weight: 600;
    }

    .sign-out-button {
        min-height: 2.25rem;
        padding: 0.25rem 0.9rem;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink);
        font: inherit;
        cursor: pointer;
    }
</style>

<script>
    window.talentAssistantSession = {
        login: async (url, userName, password) => {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ userName: userName, password: password })
            });
            return response.ok;
        },
        logout: async (url) => {
            await fetch(url, {
                method: 'POST',
                credentials: 'same-origin'
            });
        }
    };
</script>

@code {
    private async Task SignOutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
