@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject SessionService Session
@inject NavigationManager Navigation
@inject IStringLocalizer<MainLayout> Local
@inject IStringLocalizer<Common> CommonLocal

<div class="app-shell">
    <a class="skip-link" href="#main-content">@Local["SkipLink"]</a>

    <header class="masthead">
        <a class="brand" href="/" aria-label="@Local["BrandHomeLabel"]">
            <span class="brand-mark" aria-hidden="true">TA</span>
            <span class="brand-name">@CommonLocal["AppName"]</span>
        </a>

        <AuthorizeView>
            <Authorized>
                <nav class="primary-navigation" aria-label="@Local["PrimaryNavigation"]">
                    <NavLink href="" Match="NavLinkMatch.All">@Local["NavOverview"]</NavLink>
                    <NavLink href="attendance-insights">@Local["NavAttendance"]</NavLink>
                    <NavLink href="profile">@Local["NavProfile"]</NavLink>
                </nav>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <span class="user-name">@GetDisplayName(context.User)</span>
                <button type="button" class="sign-out-button" @onclick="SignOutAsync">@Local["SignOut"]</button>
            </Authorized>
        </AuthorizeView>

        <p class="environment-label">@Local["EnvironmentLabel"]</p>
    </header>

    <main class="page-content" id="main-content" tabindex="-1">
        <article>
            @Body
        </article>
    </main>

    <footer class="site-footer">
        <span>@Local["FooterFoundation"]</span>
        <span>@Local["FooterEnvironment"]</span>
    </footer>
</div>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    <span>@Local["ErrorUnexpected"]</span>
    <a href="/">@Local["ErrorReload"]</a>
    <button type="button" class="dismiss" aria-label="@Local["ErrorDismiss"]">×</button>
</div>

<style>
    .user-name {
        color: var(--muted);
        font-weight: 600;
    }

    .sign-out-button {
        min-height: 2.25rem;
        padding: 0.25rem 0.9rem;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink);
        font: inherit;
        cursor: pointer;
    }
</style>

@code {
    private static string GetDisplayName(ClaimsPrincipal user)
    {
        // The saved display name wins over the technical user name (SPEC-006 S6).
        var fullName = user.FindFirst(AuthenticationMessageHandler.FullNameClaimType)?.Value;
        return string.IsNullOrEmpty(fullName)
            ? user.Identity?.Name ?? string.Empty
            : fullName;
    }

    private async Task SignOutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
