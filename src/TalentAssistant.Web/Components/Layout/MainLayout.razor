@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Hosting
@inherits LayoutComponentBase
@inject SessionService Session
@inject NavigationManager Navigation
@inject IStringLocalizer<MainLayout> Local
@inject IStringLocalizer<Common> CommonLocal
@inject IWebHostEnvironment HostEnvironment

<div class="app-shell">
    <a class="skip-link" href="#main-content">@Local["SkipLink"]</a>

    <header class="masthead">
        <a class="brand" href="/overview" aria-label="@Local["BrandHomeLabel"]">
            <span class="brand-mark" aria-hidden="true">TA</span>
            <span class="brand-name">@CommonLocal["AppName"]</span>
        </a>

        <AuthorizeView>
            <Authorized>
                <nav class="primary-navigation" aria-label="@Local["PrimaryNavigation"]">
                    <NavLink href="overview" Match="NavLinkMatch.All">@Local["NavOverview"]</NavLink>
                    <NavLink href="assistant">@Local["NavAssistant"]</NavLink>
                    @if (context.User.IsInRole("admin"))
                    {
                        <NavLink href="admin/users">@Local["NavAdmin"]</NavLink>
                    }
                    <NavLink href="profile">@Local["NavProfile"]</NavLink>
                </nav>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <span class="user-name">@GetDisplayName(context.User)</span>
                <button type="button" class="sign-out-button" @onclick="SignOutAsync">@Local["SignOut"]</button>
            </Authorized>
        </AuthorizeView>

        <p class="environment-label">@EnvironmentLabel</p>
    </header>

    <main class="page-content" id="main-content" tabindex="-1">
        <article>
            @Body
        </article>
    </main>

    <footer class="site-footer">
        <span>@Local["FooterFoundation"]</span>
        <span>@FooterEnvironmentLabel</span>
    </footer>
</div>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    <span>@Local["ErrorUnexpected"]</span>
    <a href="/overview">@Local["ErrorReload"]</a>
    <button type="button" class="dismiss" aria-label="@Local["ErrorDismiss"]">×</button>
</div>

<style>
    .user-name {
        color: var(--muted);
        font-weight: 600;
    }

</style>

@code {
    private string EnvironmentLabel =>
        HostEnvironment.IsProduction()
            ? Local["ProductionEnvironment"]
            : HostEnvironment.IsDevelopment()
                ? Local["EnvironmentLabel"]
                : HostEnvironment.EnvironmentName;

    private string FooterEnvironmentLabel =>
        $"{EnvironmentLabel} · {Local["SyntheticData"]}";

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        // The saved display name wins over the technical user name (SPEC-006 S6).
        var fullName = user.FindFirst(AuthenticationClaimTypes.FullName)?.Value;
        return string.IsNullOrEmpty(fullName)
            ? user.Identity?.Name ?? string.Empty
            : fullName;
    }

    private async Task SignOutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
