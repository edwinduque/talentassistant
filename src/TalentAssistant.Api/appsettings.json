{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "SigningKey": "",
    "Issuer": "TalentAssistant",
    "Audience": "TalentAssistant.Local",
    "TokenLifetimeMinutes": 60,
    "LockoutMaxFailedAccessAttempts": 5,
    "LockoutMinutes": 5,
    "SeedUserName": "demo@talentassistant.local",
    "SeedPassword": ""
  },
  "AI": {
    "Provider": "router",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "ApiKey": "",
    "Model": "openai/gpt-oss-120b",
    "TimeoutSeconds": 30,
    "MaxTokens": 700,
    "MaxToolRounds": 4,
    "MaxHistoryMessages": 20,
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "ApiKey": "",
      "Model": "gemini-2.5-flash",
      "ReasoningEffort": "low",
      "TimeoutSeconds": 30
    },
    "Routing": {
      "GroqWeight": 50,
      "GeminiWeight": 50,
      "FailureThreshold": 2,
      "CooldownSeconds": 120
    }
  },
  "Hcm": {
    "Source": "Synthetic",
    "Postgres": {
      "ConnectionString": "",
      "CommandTimeoutSeconds": 15
    }
  }
}
